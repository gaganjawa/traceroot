# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.4-mini

# Vector database
QDRANT_URL=http://localhost:6333

# TraceRoot live evidence configuration (optional for fixture mode).
# CLI/UI live mode loads these settings; values alone do not activate live routing.
# Required for live mode; set your source endpoints and repository/service mapping.
TRACEROOT_LOKI_BASE_URL=http://localhost:3100
TRACEROOT_PROMETHEUS_BASE_URL=http://localhost:9090
TRACEROOT_GITHUB_REPO=owner/repo
TRACEROOT_GITHUB_SERVICE=service-name
# Optional secret shared by GitHub releases and commits; blank means no authentication.
TRACEROOT_GITHUB_TOKEN=
# Optional settings below match the current provider defaults.
TRACEROOT_LOGS_WINDOW_MINUTES=15
TRACEROOT_METRICS_WINDOW_MINUTES=15
TRACEROOT_DEPLOYMENTS_WINDOW_MINUTES=60
TRACEROOT_CODE_CHANGES_WINDOW_MINUTES=60
TRACEROOT_METRICS_METRIC_NAME=http_server_request_duration_seconds
TRACEROOT_METRICS_UNIT=seconds
TRACEROOT_METRICS_STEP_SECONDS=30
TRACEROOT_LIVE_TIMEOUT_SECONDS=10.0
