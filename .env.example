# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.4-mini

# Vector database
QDRANT_URL=http://localhost:6333

# Live evidence (optional). Values alone do not activate live routing.
# Explicitly load configuration, build_live_runtime(...), then activate_live_runtime(...).
# Required when building a live runtime; provide your own source endpoints and mapping.
# TRACEROOT_LOKI_BASE_URL=
# TRACEROOT_PROMETHEUS_BASE_URL=
# TRACEROOT_GITHUB_REPO=
# TRACEROOT_GITHUB_SERVICE=
# Optional secret shared by GitHub releases and commits; blank means no authentication.
# TRACEROOT_GITHUB_TOKEN=
# Optional settings below match the current provider defaults.
# TRACEROOT_LOGS_WINDOW_MINUTES=15
# TRACEROOT_METRICS_WINDOW_MINUTES=15
# TRACEROOT_DEPLOYMENTS_WINDOW_MINUTES=60
# TRACEROOT_CODE_CHANGES_WINDOW_MINUTES=60
# TRACEROOT_METRICS_METRIC_NAME=http_server_request_duration_seconds
# TRACEROOT_METRICS_UNIT=seconds
# TRACEROOT_METRICS_STEP_SECONDS=30
# TRACEROOT_LIVE_TIMEOUT_SECONDS=10.0
